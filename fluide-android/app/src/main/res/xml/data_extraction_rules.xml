<?xml version="1.0" encoding="utf-8"?>
<!--
    L'historique des mesures décrit CE téléphone : le copier vers un autre appareil
    mélangerait des résultats de matériels différents. Rien n'est sauvegardé ni transféré.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
