<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Aucune permission INTERNET : l'appli ne peut rien envoyer hors du téléphone.
        Aucune permission KILL_BACKGROUND_PROCESSES : pas de « nettoyeur de RAM » (contre-productif).
    -->

    <!-- Accordée une seule fois par ADB (pm grant) : régler la vitesse des animations. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- « Accès à l'utilisation » (accordé dans les Paramètres) : applis inutilisées et leur taille. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Voir les applis installées, dont les applis préinstallées connues. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Ouvrir la fenêtre de désinstallation du système (vous confirmez toujours). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Recherche des gros fichiers et des APK oubliés (accordé dans les Paramètres). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Avant Android 12, allowBackup="false" suffit à désactiver toute sauvegarde ou transfert ;
         dataExtractionRules prend le relais à partir d'Android 12. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fluide"
        tools:ignore="DataExtractionRules"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FrameTestActivity"
            android:exported="false"
            android:excludeFromRecents="true" />
    </application>
</manifest>
