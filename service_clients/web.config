<?xml version="1.0" encoding="UTF-8"?>
<!--
  D8 · Service clients — configuration IIS du dossier service_clients.
  Le traitement des fichiers .php (FastCGI), le pool d'applications et l'authentification anonyme
  sont déclarés par installer-service-clients.ps1 dans applicationHost.config (sections verrouillées
  par défaut dans les web.config).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- données, réglages et fichiers d'installation jamais servis par le web -->
        <hiddenSegments>
          <remove segment="data" />
          <add segment="data" />
          <remove segment="config.php" />
          <add segment="config.php" />
          <remove segment=".user.ini" />
          <add segment=".user.ini" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".ps1" />
          <add fileExtension=".ps1" allowed="false" />
          <remove fileExtension=".cmd" />
          <add fileExtension=".cmd" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".json" />
          <add fileExtension=".json" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
        <!-- restauration d'une sauvegarde complète : jusqu'à 64 Mo -->
        <requestLimits maxAllowedContentLength="67108864" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!-- <remove> d'abord : évite l'erreur 500.19 si le serveur ou le site définit déjà ces en-têtes -->
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
    <!-- les postes chargent toujours la dernière version de la page après une mise à jour -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
