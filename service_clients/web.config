<?xml version="1.0" encoding="UTF-8"?>
<!--
  D8 · Service clients — configuration IIS du dossier service_clients.
  Le traitement des fichiers .php (FastCGI) est déclaré par installer-service-clients.ps1
  dans applicationHost.config : la section <handlers> est verrouillée par défaut dans les web.config.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- données, réglages et fichiers d'installation jamais servis par le web -->
        <hiddenSegments>
          <add segment="data" />
          <add segment="config.php" />
          <add segment=".user.ini" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".cmd" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
        <!-- restauration d'une sauvegarde complète : jusqu'à 64 Mo -->
        <requestLimits maxAllowedContentLength="67108864" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
    <!-- les postes chargent toujours la dernière version de la page après une mise à jour -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
