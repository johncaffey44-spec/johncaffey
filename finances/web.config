<?xml version="1.0" encoding="UTF-8"?>
<!--
  Boussole — protections pour IIS : dossiers internes invisibles, en-têtes de sécurité.
  Chaque <add> est précédé d'un <remove> : si le serveur ou le site déclare déjà la même règle
  (extensions .sqlite, .log, .bak… bloquées par le script d'installation d'IIS + PHP), IIS ne
  refuse pas ce fichier pour « entrée en double » (erreur 500.19).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="data" />
          <add segment="data" />
          <remove segment="lib" />
          <add segment="lib" />
          <remove segment="tests" />
          <add segment="tests" />
          <remove segment="outils" />
          <add segment="outils" />
          <remove segment="windows" />
          <add segment="windows" />
          <remove segment="config.local.php" />
          <add segment="config.local.php" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".sqlite" />
          <add fileExtension=".sqlite" allowed="false" />
          <remove fileExtension=".key" />
          <add fileExtension=".key" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".ps1" />
          <add fileExtension=".ps1" allowed="false" />
          <remove fileExtension=".cmd" />
          <add fileExtension=".cmd" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".bak" />
          <add fileExtension=".bak" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
