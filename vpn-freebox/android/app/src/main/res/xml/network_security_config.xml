<?xml version="1.0" encoding="utf-8"?>
<!-- Tout est chiffré (HTTPS) sauf le test local « Ma Freebox répond-elle ? »,
     qui interroge l'interface de la box à travers le tunnel VPN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">mafreebox.freebox.fr</domain>
        <domain includeSubdomains="false">192.168.1.254</domain>
        <domain includeSubdomains="false">212.27.38.253</domain>
    </domain-config>
</network-security-config>
