<?xml version="1.0" encoding="UTF-8"?>
<!--
  D8 Support : configuration IIS de l'application.
  À placer à côté de index.php (INSTALLER.cmd le fait automatiquement).

  Le reste de la configuration IIS (gestionnaire PHP, pages d'erreur) est
  écrit par installer-iis.ps1 dans applicationHost.config : ces sections
  sont verrouillées par défaut et provoqueraient une erreur 500.19 ici.
-->
<configuration>
  <system.webServer>

    <!-- http://serveur/ticketing/ ouvre directement l'application -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- 3 pièces jointes de 5 Mo par envoi : 30 Mo laissent de la marge
             (doit rester supérieur à post_max_size de php.ini) -->
        <requestLimits maxAllowedContentLength="31457280" />
        <!-- data\ contient la base, les sessions, les pièces jointes et les
             journaux : IIS répond 404 à toute adresse qui passe par ce dossier -->
        <hiddenSegments>
          <add segment="data" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
