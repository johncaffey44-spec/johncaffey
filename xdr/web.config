<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sentinelle XDR — réglages IIS (Windows 11 Pro).
  - masque les dossiers internes (moteur PHP, données, configuration, outils, certificats) ;
  - désactive la liste des fichiers ;
  - ajoute les en-têtes de sécurité (CSP stricte : aucun script ni style externe ou en ligne).

  Chaque <add> est précédé d'un <remove> : quand le serveur déclare déjà la même règle (IIS
  « déjà sécurisé » par le script d'installation d'IIS + PHP : extensions .sqlite, .log, .bak
  bloquées, mêmes en-têtes envoyés), IIS refuserait sinon tout le dossier pour « entrée en
  double » (erreur 500.19). Leçon tirée de Boussole 1.1.1, sur le même serveur.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- le test de débit envoie des morceaux de 4 Mo : 8 Mo au plus par requête -->
        <requestLimits maxAllowedContentLength="8388608" />
        <hiddenSegments>
          <remove segment="app" />
          <add segment="app" />
          <remove segment="data" />
          <add segment="data" />
          <remove segment="config" />
          <add segment="config" />
          <remove segment="tools" />
          <add segment="tools" />
          <remove segment="certs" />
          <add segment="certs" />
          <remove segment="docs" />
          <add segment="docs" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".sqlite" />
          <add fileExtension=".sqlite" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".ps1" />
          <add fileExtension=".ps1" allowed="false" />
          <remove fileExtension=".cmd" />
          <add fileExtension=".cmd" allowed="false" />
          <remove fileExtension=".pem" />
          <add fileExtension=".pem" allowed="false" />
          <remove fileExtension=".txt" />
          <add fileExtension=".txt" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".bak" />
          <add fileExtension=".bak" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" />
        <remove name="X-Robots-Tag" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
